PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=your-mongodb-connection-string
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
# Keep false for local HTTP. Production must use true over HTTPS.
COOKIE_SECURE=false
# Use lax for same-site deployments. none requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
# false for direct hosting; use a specific proxy hop count such as 1 behind one proxy.
TRUST_PROXY=false
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_EXPIRES_IN_MINUTES=15
EMAIL_VERIFICATION_EXPIRES_HOURS=24
VERIFICATION_RESEND_RATE_LIMIT_MAX=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
